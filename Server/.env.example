# ---------------------------------------------------------------------------
# StaffSync API — copy this file to Server/.env and fill in your own values.
#   PowerShell:  Copy-Item .env.example .env
#   bash:        cp .env.example .env
#
# NEVER commit the real .env file. It is already listed in .gitignore.
# Nothing in this file is a real credential — every value below is a placeholder.
# ---------------------------------------------------------------------------

# development | production | test
NODE_ENV=development

# Port the Express API listens on. The frontend expects 5000 by default.
PORT=5000

# ---------------------------------------------------------------------------
# MongoDB connection string — REQUIRED
# ---------------------------------------------------------------------------
# Atlas (free tier):  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/staffsync?retryWrites=true&w=majority
# Local MongoDB:      mongodb://127.0.0.1:27017/staffsync
# Throwaway (no DB):  npm run db:memory   → then use mongodb://127.0.0.1:27017/staffsync
#
# The database name ("staffsync") must appear after the first "/" so the app and
# `npm run seed` operate on the same database.
# URL-encode special characters in the password: @ → %40, # → %23, : → %3A
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/staffsync?retryWrites=true&w=majority

# ---------------------------------------------------------------------------
# Authentication — REQUIRED
# ---------------------------------------------------------------------------
# Long random string (32+ characters). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
JWT_EXPIRES_IN=7d

# Where the React app runs. Comma-separate multiple origins.
# Add the exact scheme + host + port you open in the browser.
CLIENT_URL=http://localhost:5173

# ---------------------------------------------------------------------------
# Optional tuning
# ---------------------------------------------------------------------------
# bcrypt cost. 12 is a good default; tests use 4 for speed.
BCRYPT_ROUNDS=12

# Maximum JSON request size (avatars are sent as data URIs).
JSON_BODY_LIMIT=2mb

# Rate limiting for /auth/login and /auth/register.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=50

# Seed the demo workspace automatically on boot — only when the DB is empty.
SEED_ON_START=false

# Password given to the seeded demo accounts. Change it if you deploy the demo.
# It is also the password `npm run db:doctor -- --fix-demo-passwords` restores.
SEED_DEMO_PASSWORD=StaffSync@123
