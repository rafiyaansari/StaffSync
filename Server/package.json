{
  "name": "staffsync-server",
  "version": "1.0.0",
  "private": true,
  "description": "StaffSync HR management REST API (Express + MongoDB)",
  "type": "module",
  "main": "server.js",
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "start:dns": "node scripts/dns-override.mjs",
    "dev:dns": "node scripts/dns-override.mjs",
    "seed": "node seed/run.js",
    "seed:if-empty": "node seed/run.js --if-empty",
    "db:doctor": "node scripts/doctor.mjs",
    "db:doctor:dns": "node --import ./scripts/dns-preload.mjs scripts/doctor.mjs",
    "verify:auth": "node scripts/verify-auth.mjs",
    "verify:auth:dns": "node --import ./scripts/dns-preload.mjs scripts/verify-auth.mjs",
    "test": "cross-env NODE_ENV=test node --test --test-concurrency=1 --import ./tests/setup.js tests/",
    "test:watch": "cross-env NODE_ENV=test node --test --watch --import ./tests/setup.js tests/",
    "db:memory": "node scripts/memoryServer.mjs"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "morgan": "^1.10.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "mongodb-memory-server": "^10.1.3",
    "nodemon": "^3.1.9",
    "supertest": "^7.0.0"
  }
}
