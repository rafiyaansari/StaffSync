# ---------------------------------------------------------------------------
# Optional client configuration.
# Copy to Client/.env only if you need it:
#   PowerShell:  Copy-Item .env.example .env
#
# By default the app talks to the live API through the Vite dev proxy
# (/api -> http://127.0.0.1:5000), so nothing here is required for local use.
# No secrets belong in this file — everything here ends up in the browser bundle.
# ---------------------------------------------------------------------------

# live (default) | mock
# mock runs the original browser-only demo with localStorage data and needs no
# backend. Never use it to "fix" an API problem: start the API instead.
# VITE_API_MODE=live

# Absolute API base URL. Only needed when the API is NOT reachable through the
# dev proxy (different port, remote server, or a production build).
# VITE_API_URL=http://localhost:5000/api

# Port of the API used by the Vite proxy during development.
# VITE_API_PROXY=http://127.0.0.1:5000

# Shows the one-click demo role buttons on the sign-in screen. They only work if
# the demo accounts were seeded (npm run seed). Keep false for production.
# VITE_DEMO_LOGINS=true
